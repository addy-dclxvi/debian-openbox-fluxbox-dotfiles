[begin] (Menu)
	[exec] (Run) {fbrun}
	[exec] (Terminal) {x-terminal-emulator}
	[exec] (Web Browser) {xdg-open about:home}
	[exec] (File Manager) {xdg-open ~}

	[separator]

	[submenu] (Accessories)
		[exec] (Pluma Text Editor) {pluma}
		[exec] (MATE Calculator) {mate-calc}
		[exec] (Engrampa Archive Manager) {engrampa}
		[exec] (MATE Screenshot) {mate-screenshot}
		[exec] (MATE Search Tool) {mate-search-tool}
		[exec] (Vim) {mate-terminal -e vim}
	[end]

	[submenu] (Internet)
		[exec] (Network Connections) {nm-connection-editor}
		[exec] (Firefox) {firefox}
	[end]

	[submenu] (Multimedia)
		[exec] (GIMP Image Editor) {gimp}
		[exec] (Eye of MATE Image Viewer) {eom}
		[exec] (Mate Color Select) {mate-color-select}
		[exec] (MPV Media Player) {mpv --player-operation-mode=pseudo-gui -- %U}
		[exec] (Volume Control) {mate-volume-control}
	[end]

	[submenu] (Office)
		[exec] (LibreOffice) {libreoffice}
		[exec] (LibreOffice Writer) {libreoffice --writer}
		[exec] (LibreOffice Calc) {libreoffice --calc}
		[exec] (LibreOffice Impress) {libreoffice --impress}
		[exec] (LibreOffice Draw) {libreoffice --draw}
		[exec] (LibreOffice Math) {libreoffice --math}
		[exec] (Atril Document Viewer) {atril}
		[exec] (MATE Dictionary) {mate-dictionary}
	[end]

	[submenu] (Settings)
		[exec] (MATE Control Center) {matecc}
		[exec] (Appearance) {mate-appearance-properties}
		[exec] (Displays) {mate-display-properties}
		[exec] (Keyboard) {mate-keyboard-properties}
		[exec] (Mouse) {mate-settings-mouse}
		[exec] (Power Management) {mate-power-preferences}
		[exec] (Screensaver) {mate-screensaver-preferences}
		[exec] (Session Properties) {mate-session-properties}
	[end]

	[submenu] (System)
		[exec] (MATE Terminal) {mate-terminal}
		[exec] (Fish Shell) {mate-terminal -e fish}
		[exec] (Caja File Manager) {caja}
		[exec] (Ranger File Manager) {mate-terminal -e ranger}
		[exec] (MATE System Monitor) {mate-system-monitor}
		[exec] (MATE System Log) {mate-system-log}
		[exec] (Disk Usage Analyzer) {mate-disk-usage-analyzer}
		[exec] (GParted) {gparted}
	[end]

	[separator]
	[submenu] (Fluxbox)
		[submenu] (Styles)
			[submenu] (User)
				[stylesmenu] (User Styles) {~/.fluxbox/styles}
			[end]
			[submenu] (System)
				[stylesmenu] (System Styles) {/usr/share/fluxbox/styles}
			[end]
		[end]
		[workspaces] (Workspaces)
		[reconfig] (Reconfigure)
		[restart] (Restart)
	[end]

	[separator]
	[submenu] (Exit)
		[exit] (Logout)
		[exec] (Suspend) {systemctl suspend}
		[exec] (Hibernate) {systemctl hibernate}
		[exec] (Restart) {systemctl reboot}
		[exec] (Poweroff) {systemctl poweroff}
	[end]
[end]
